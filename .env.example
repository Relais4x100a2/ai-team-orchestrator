# ============================================================
# AI Team Orchestrator — Variables d'environnement
# ============================================================
# Copie ce fichier en .env et remplis les valeurs

# Clé API Cursor (obligatoire)
# Récupère-la sur https://cursor.com/dashboard → API Keys
CURSOR_API_KEY=cur_xxxxxxxxxxxxx

# URL du repo GitHub sur lequel les agents travaillent
TARGET_REPO_URL=https://github.com/Relais4x100a2/dataset_style
TARGET_BRANCH=deploy/caprover-relais4

# Modèles à utiliser par défaut
# Tâches « lourdes » (PM, architecte, red team) — version économique par défaut (surchargeable)
MODEL_STRONG=gpt-5-mini
# Tâches rapides (UX, dev, QA) — Composer 2
MODEL_FAST=composer-2

# GitHub Personal Access Token (pour créer des issues/PRs automatiquement)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
