# ============================================================
# AI Team Orchestrator — Variables d'environnement
# ============================================================
# Copie ce fichier en .env et remplis les valeurs

# Clé API Cursor (obligatoire)
# Récupère-la sur https://cursor.com/dashboard → API Keys
CURSOR_API_KEY=cur_xxxxxxxxxxxxx

# URL du repo GitHub sur lequel les agents travaillent
TARGET_REPO_URL=https://github.com/Relais4x100a2/dataset_style
TARGET_BRANCH=deploy/caprover-relais4

# ------------------------------------------------------------
# Modèles (optionnel — les défauts ci-dessous sont déjà optimaux)
# ------------------------------------------------------------
# Hiérarchie de résolution (du plus prioritaire au moins) :
#   1. MODEL_<ROLE>  — override pour un rôle précis (ex: MODEL_PM)
#   2. MODEL_STRONG / MODEL_FAST — override par tier (sans params)
#   3. Défauts codés dans src/agent-config.ts (id + params SDK optimaux)
#
# Quand un env var surcharge un modèle, les params sont abandonnés
# (le variant par défaut du modèle est utilisé). Pour des params fins,
# modifier directement AGENT_DEFINITIONS dans src/agent-config.ts.
#
# Modèles disponibles via GET https://api.cursor.com/v1/models
# Defaults par rôle :
#   pm          → claude-sonnet-4-6  (thinking:true, context:1m, effort:medium)
#   architect   → claude-sonnet-4-6  (thinking:true, context:1m, effort:high)
#   dev         → gpt-5.3-codex      (reasoning:high, fast:true)
#   qa          → claude-sonnet-4-6  (thinking:true, context:200k, effort:medium)
#   redteam     → claude-opus-4-7    (thinking:true, context:1m, effort:xhigh)
#   devops/sre  → gpt-5.3-codex      (reasoning:medium)
#   release     → gpt-5.4-mini       (reasoning:low)
#   ux/ui       → claude-sonnet-4-6  (thinking:false, context:200k, effort:medium)
#   techwriter  → claude-sonnet-4-6  (thinking:false, context:200k, effort:low)
#   privacy     → claude-opus-4-7    (thinking:true, context:300k, effort:high)

# Override par tier (remplace tous les rôles du tier, sans params) :
# MODEL_STRONG=claude-sonnet-4-6
# MODEL_FAST=composer-2

# Override par rôle (prioritaire sur MODEL_STRONG/MODEL_FAST, sans params) :
# MODEL_PM=claude-opus-4-7
# MODEL_ARCHITECT=gpt-5.5
# MODEL_DEV=gpt-5.3-codex
# MODEL_QA=claude-sonnet-4-6
# MODEL_REDTEAM=claude-opus-4-7
# MODEL_DEVOPS=gpt-5.3-codex
# MODEL_SRE=gpt-5.3-codex
# MODEL_RELEASE=gpt-5.4-mini
# MODEL_UX=claude-sonnet-4-6
# MODEL_UI=claude-sonnet-4-6
# MODEL_TECHWRITER=claude-haiku-4-5
# MODEL_PRIVACY=claude-opus-4-7

# GitHub Personal Access Token (pour créer des issues/PRs automatiquement)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
